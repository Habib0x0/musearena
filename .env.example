# MuseArena local configuration names. Copy to .env and fill real values.
# Never commit real secrets. Frontend VITE_* values are mirrored in .env.local.

# Supabase / data plane
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_JWKS_URL=

# Clerk (frontend session + designer/API token verification)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_DESIGN_API_URL=http://localhost:8787
# Product analytics. Empty means the app makes no analytics calls at all.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_LEARNING_API_URL=http://127.0.0.1:8788
META_TRAINER_URL=

# Model surfaces. Configure the surface you select; there is no silent fallback
# for an explicitly selected but unconfigured surface.
META_API_KEY=
META_BASE_URL=
META_MODEL_ID=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_BASE_URL=
MODAL_MODEL_ID=
MODAL_ROUTING_AFFINITY_KEY=
MODAL_REASONING_EFFORT=medium
# Small agents (personas) use Muse Glimmer 30B on the separate ep-glimmer
# SGLang endpoint. Its served model name is `glimmer`; the repository ID
# meta-models/Muse-Glimmer-30B canonicalizes to it. Leave these blank for
# the defaults. Distinct Glimmer proxy tokens are optional; when neither is
# set, the shared MODAL_PROXY_TOKEN_* pair above is used.
MODAL_GLIMMER_BASE_URL=
MODAL_GLIMMER_MODEL_ID=glimmer
MODAL_GLIMMER_PROXY_TOKEN_ID=
MODAL_GLIMMER_PROXY_TOKEN_SECRET=
MODAL_GLIMMER_ROUTING_AFFINITY_KEY=
MODAL_GLIMMER_REASONING_EFFORT=low
# Role-specific aliases accepted for the same Glimmer persona endpoint.
MODAL_PERSONA_BASE_URL=
MODAL_PERSONA_MODEL_ID=

# Managed platform (deployment/.platform.env is generated by deployment status)
TEMPORAL_ADDRESS=localhost:7234
TEMPORAL_NAMESPACE=default
# Trajectory export to Langfuse (optional integration)
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=9464
# Multi-host worker routing. Leave MUSEARENA_WORKER_ID empty for the legacy
# single-worker queue. In multi-host mode each worker needs a stable ID; its
# Temporal queue defaults to musearena-<worker-id>. Routes: kvm, vm, container.
MUSEARENA_WORKER_ID=
MUSEARENA_WORKER_TASK_QUEUE=
MUSEARENA_WORKER_ROUTES=kvm,vm,container
MUSEARENA_WORKER_OWNS_UNROUTED=
MUSEARENA_TARGET_WORKER_ID=
# Continual-training proposal sweep. Disabled by default; enable on exactly
# one worker. It derives labelled-trace/correction/agent-run aggregates from
# Supabase and only creates proposals; approval and training still gate spend.
MUSEARENA_CONTINUAL_SWEEP=
MUSEARENA_CONTINUAL_SWEEP_INTERVAL_MS=3600000
MUSEARENA_CONTINUAL_LABELLED_TRACES=50
MUSEARENA_CONTINUAL_CORRECTIONS=10
MUSEARENA_CONTINUAL_CORRECTION_WINDOW_DAYS=30
MUSEARENA_CONTINUAL_REGRESSION_RUNS=5
MUSEARENA_CONTINUAL_RED_OBJECTIVES_BAR=0.8
MUSEARENA_CONTINUAL_BLUE_CONTAINMENT_BAR=0.8
MUSEARENA_CONTINUAL_BLUE_MTTD_BAR_MINUTES=
MUSEARENA_CONTINUAL_SCHEDULE_DAYS=
MUSEARENA_CONTINUAL_BUDGET_USD=
MUSEARENA_CONTINUAL_METHOD=sft
PLATFORM_TEMPORAL_PORT=7234
PLATFORM_LANGFUSE_PORT=3100
PLATFORM_PROMETHEUS_PORT=9095

# Local services
DESIGN_HOST=127.0.0.1
DESIGN_PORT=8787
DESIGN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MUSEARENA_API_HOST=127.0.0.1
MUSEARENA_API_PORT=8788
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MUSEARENA_AGENT_RUNTIME=

# Provisioning state/images
PULUMI_CONFIG_PASSPHRASE=
PULUMI_PASSPHRASE=
PULUMI_STATE_DIR=
KVM_IMAGE_CACHE=
KVM_WINDOWS_IMAGE=
GOLDEN_IMAGE_DIR=
ARENA_GOLDEN_MANIFEST=
ARENA_ROCKY_GOLDEN_MANIFEST=
VM_STATE_DIR=
MUSEARENA_POLICY_PACK=
MUSEARENA_LOCAL_GATES=

# Hosted deployments (e.g. musearena.site): restrict sign-in to these email
# domains. Leave unset for local development. Requires CLERK_SECRET_KEY on the
# API/designer host. Set the same list for the frontend build.
# MUSEARENA_ALLOWED_EMAIL_DOMAINS=meta.com,baseten.co,modal.com,cerebralvalley.ai,fireworks.ai
# VITE_ALLOWED_EMAIL_DOMAINS=meta.com,baseten.co,modal.com,cerebralvalley.ai,fireworks.ai
